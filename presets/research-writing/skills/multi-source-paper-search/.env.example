# multi-source-paper-search — local keys
# Copy to `.env` (same dir) and fill in. fanout.py auto-loads this on startup
# and does NOT override anything already in your shell environment.
# `.env` is gitignored; `.env.example` is the committed template.

# Perplexity source (web-grounded synthesis). Get a key + add credits:
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Semantic Scholar source (optional — works keyless but 429s; key removes that).
#   https://www.semanticscholar.org/product/api
S2_API_KEY=

# arXiv (Valyu) does NOT read an env var — configure it once via the skill's
# own setup so it persists to ~/.valyu/config.json:
#   SEARCH=$(find ~/.claude -path "*/arxiv-search/*/scripts/search" -type f | head -1)
#   "$SEARCH" setup <your-valyu-key>      # free $10 credit at https://platform.valyu.ai
